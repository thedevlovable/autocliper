# ─────────────────────────────────────────────────────────────
#  AutoCliper — Railway environment variables
#  Copy these into your Railway service's Variables tab.
#  Lines starting with # are comments; do NOT copy them as-is.
# ─────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────

# Set by Railway automatically — do NOT override.
# PORT=

# Your production domain (used for CORS allow-list).
ALLOWED_ORIGIN=https://autocliper.com

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARS

# Runtime mode — must be "production" on Railway.
NODE_ENV=production

# ── Database (add Railway PostgreSQL plugin) ──────────────────
# Railway injects this automatically when you add a Postgres plugin.
# DATABASE_URL=postgresql://...

# ── Optional ──────────────────────────────────────────────────

# Maximum Object Storage usage in GB before old clips are evicted.
# Default: 5
# STORAGE_SIZE_CAP_GB=5

# Absolute path to the yt-dlp binary.
# Not needed if the binary is on PATH (e.g. installed to /usr/local/bin by the build step).
# YTDLP_PATH=/usr/local/bin/yt-dlp

# Log level for pino (trace | debug | info | warn | error | fatal).
# Default: info
# LOG_LEVEL=info
